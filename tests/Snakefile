# Snakefile for running breseq's consistency tests in parallel.
#
# Each test lives in tests/<name>/testcmd.sh (see tests/common.sh for the
# do_build/do_check/do_clean conventions those scripts follow -- this file
# does not change those conventions, it just discovers and launches them).
#
# Usage (normally driven by 'make test' / 'make test-long' -- see Makefile.am,
# which invokes this from the top-level source directory, exactly as the old
# tests/test.sh was invoked):
#   snakemake -s tests/Snakefile --cores N [--keep-going] [--config long=1]
#
# IMPORTANT: this Snakefile intentionally does NOT change the working
# directory (no 'workdir:'). Each test's output .gd file embeds the literal
# command line that produced it (the '#=COMMAND' line), including
# working-directory-relative paths -- expected.gd files were generated with
# the working directory at the top-level source directory, so tests must keep
# running from there for those paths (and thus the comparisons) to match.
#
# Each test declares how many cores it needs via a 'TEST_CORES=N' assignment
# near the top of its testcmd.sh (see tests/common.sh). Snakemake schedules
# tests in parallel so that the sum of cores in use never exceeds the total
# budget passed via --cores.
#
# A test that depends on another test's output (e.g. lambda_mixed_pop_cl_tabulate
# reads files generated by lambda_mixed_pop) declares this via a
# 'TEST_DEPENDS=<name>[,<name>...]' assignment alongside TEST_CORES. This is a
# plain variable assignment that common.sh ignores -- it exists purely so this
# Snakefile can add a real dependency edge (on tests/<name>/test.done) and
# guarantee the prerequisite test finishes (successfully) first, which parallel
# scheduling would not otherwise ensure. Serial runners (tests/run.sh etc.)
# don't need this -- their sorted discovery order already happens to do the
# right thing for the current set of dependent tests.
#
# A 'long' test that needs large real-world data (reads from ENA, references from
# NCBI) declares it with a 'TEST_DATA=<dataset>[,<dataset>...]' assignment, again
# alongside TEST_CORES. Each dataset becomes a node in the job graph, so a data
# set shared by several long tests is downloaded exactly once and independent data
# sets download in parallel. See tests/test_data_manifest.tsv and
# tests/fetch_test_data.sh. 'make test' never downloads anything: long tests are
# not discovered without --config long=1, and declaring TEST_DATA on a non-long
# test is a hard error (see below).

import glob
import os
import re

RUN_LONG = bool(config.get("long", False))


def discover_tests():
    """Find test directories the same way tests/test.sh does: one level
    below tests/, skipping '_'-prefixed directories, skipping directories
    whose name ends in '_disabled', and skipping directories with 'long' in
    the name unless long tests were requested.
    Paths are relative to the working directory (the top-level source
    directory), matching how 'make test' invokes this Snakefile."""
    names = []
    for path in sorted(glob.glob(os.path.join("tests", "*", "testcmd.sh"))):
        name = os.path.basename(os.path.dirname(path))
        if name.startswith("_"):
            continue
        # Directories whose name ends in '_disabled' are never run by
        # 'make test'/'make test-long' -- they only run when invoked by name
        # (e.g. ./tests/run.sh <name>). There is deliberately no flag to
        # include them here.
        if name.endswith("_disabled"):
            continue
        if ("long" in name) and not RUN_LONG:
            continue
        names.append(name)
    return names


def parse_test_cores(name):
    """Read the TEST_CORES=N declaration from a testcmd.sh, defaulting to 1
    (matching the default set in tests/common.sh for tests that don't set it,
    e.g. ones that only invoke gdtools)."""
    with open(os.path.join("tests", name, "testcmd.sh")) as f:
        for line in f:
            m = re.match(r"^\s*TEST_CORES=(\d+)\s*$", line)
            if m:
                return int(m.group(1))
    return 1


def parse_test_depends(name):
    """Read the TEST_DEPENDS=<name>[,<name>...] declaration from a testcmd.sh,
    defaulting to no dependencies (see the header comment above for why this
    exists)."""
    with open(os.path.join("tests", name, "testcmd.sh")) as f:
        for line in f:
            m = re.match(r"^\s*TEST_DEPENDS=([\w,]+)\s*$", line)
            if m:
                return m.group(1).split(",")
    return []


def parse_test_data(name):
    """Read the TEST_DATA=<dataset>[,<dataset>...] declaration from a testcmd.sh,
    defaulting to no external data. Each dataset names a group of rows in
    tests/test_data_manifest.tsv that tests/fetch_test_data.sh downloads,
    md5-verifies and caches. Only 'long' tests may declare this -- see the
    assertion below."""
    with open(os.path.join("tests", name, "testcmd.sh")) as f:
        for line in f:
            m = re.match(r"^\s*TEST_DATA=([\w,]+)\s*$", line)
            if m:
                return m.group(1).split(",")
    return []


TESTS = discover_tests()
TEST_CORES = {name: parse_test_cores(name) for name in TESTS}
TEST_DEPENDS = {name: parse_test_depends(name) for name in TESTS}
TEST_DATA = {name: parse_test_data(name) for name in TESTS}

# Where the per-dataset "this has been fetched" markers live. Deliberately inside
# the worktree and NOT in the data cache itself: the cache may be shared between
# worktrees (BRESEQ_TEST_DATA_DIR) and must not be owned by any one Snakemake run.
# 'make clean-tests' removes this directory but never the cache.
TEST_DATA_STAMP_DIR = "tests/.test_data_stamps"

# Safety net keeping 'make test' completely offline. Long tests are the only ones
# allowed to declare TEST_DATA, and they are excluded from TESTS entirely unless
# --config long=1 was passed, so a plain 'make test' can never instantiate a
# fetch_test_data job. Catch a misplaced declaration loudly here rather than
# silently downloading gigabytes during a normal test run or in CI.
_offenders = sorted(n for n, d in TEST_DATA.items() if d and "long" not in n)
if _offenders:
    raise WorkflowError(
        "TEST_DATA may only be declared by tests whose directory name contains "
        "'long' (i.e. those that run only under 'make test-long'), because it "
        "triggers network downloads. Offending tests: " + ", ".join(_offenders)
    )


def test_inputs(wildcards):
    """A test's prerequisites: any tests it depends on (TEST_DEPENDS), plus one
    marker per external dataset it declares (TEST_DATA). Routing the fetch through
    the job graph means several long tests sharing a dataset download it once, and
    independent datasets download in parallel."""
    deps = [f"tests/{dep}/test.done" for dep in TEST_DEPENDS.get(wildcards.test, [])]
    data = [f"{TEST_DATA_STAMP_DIR}/{ds}.fetched"
            for ds in TEST_DATA.get(wildcards.test, [])]
    return deps + data


wildcard_constraints:
    # Matches the dataset-name rule enforced by 'fetch_test_data.sh --lint'.
    dataset=r"[A-Za-z0-9_]+",


rule all:
    input:
        [f"tests/{test}/test.done" for test in TESTS]


rule fetch_test_data:
    """Download and md5-verify one dataset from tests/test_data_manifest.tsv.

    Only the marker is declared as output, never the cached data: Snakemake
    deletes a failed job's outputs, and the cache is potentially shared between
    worktrees. fetch_test_data.sh keeps its own sidecar stamps next to the cached
    files, so running this against an already-populated cache is a handful of
    stat() calls rather than a re-hash of gigabytes.

    'resources: download_slots' caps how many downloads run at once, but note that
    a resource is only enforced when a limit is supplied on the command line --
    hence the --resources flag in Makefile.am's test-long target."""
    output:
        touch(f"{TEST_DATA_STAMP_DIR}/{{dataset}}.fetched")
    log:
        f"{TEST_DATA_STAMP_DIR}/{{dataset}}.log"
    threads: 1
    resources:
        download_slots=1
    shell:
        "tests/fetch_test_data.sh {wildcards.dataset} > {log} 2>&1"


rule run_test:
    input:
        test_inputs
    output:
        touch("tests/{test}/test.done")
    log:
        "tests/{test}/test.log"
    threads: lambda wildcards: TEST_CORES.get(wildcards.test, 1)
    shell:
        "tests/run_logged_test.sh tests/{wildcards.test} {log} tests/{wildcards.test}/test.result"
